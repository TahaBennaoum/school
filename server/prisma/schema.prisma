// Système de Gestion d'École Privée - Schéma Prisma
// CEM et Lycée

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  DIRECTOR
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  PENDING    // En attente de validation
  APPROVED   // Validé par l'admin
  REJECTED   // Rejeté par l'admin
  SUSPENDED  // Suspendu
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum Level {
  // CEM (Collège)
  AM1  // 1ère Année Moyenne
  AM2  // 2ème Année Moyenne
  AM3  // 3ème Année Moyenne
  AM4  // 4ème Année Moyenne (BEM)
  // Lycée
  AS1  // 1ère Année Secondaire
  AS2  // 2ème Année Secondaire
  AS3  // 3ème Année Secondaire (BAC)
}

enum RoomType {
  CLASSROOM
  LAB
  LIBRARY
  GYM
  AUDITORIUM
  COMPUTER_LAB
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum GradeType {
  HOMEWORK    // Devoir
  QUIZ        // Interrogation
  EXAM        // Examen
  PROJECT     // Projet
  COMPOSITION // Composition trimestrielle
}

enum PaymentType {
  REGISTRATION  // Frais d'inscription
  TUITION       // Scolarité mensuelle
  TRANSPORT     // Transport
  CANTEEN       // Cantine
  UNIFORM       // Uniforme
  BOOKS         // Livres
  OTHER         // Autre
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  ABSENCE
  GRADE
  PAYMENT
  SCHEDULE
  GENERAL
}

// ==================== MODELS ====================

model User {
  id            String     @id @default(cuid())
  supabaseId    String     @unique
  email         String     @unique
  firstName     String
  lastName      String
  role          Role       @default(TEACHER)
  status        UserStatus @default(PENDING)
  phone         String?
  avatar        String?
  isActive      Boolean    @default(true)
  rejectionNote String?    // Note when user is rejected
  validatedAt   DateTime?  // When the user was validated
  validatedBy   String?    // Admin who validated
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations optionnelles (un seul sera défini selon le rôle)
  student       Student?
  teacher       Teacher?
  parent        Parent?

  notifications Notification[]
  permissions   UserPermission[]
  sentMessages     Message[]    @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")
  conversations    ConversationParticipant[]

  @@index([email])
  @@index([supabaseId])
  @@index([role])
  @@index([status])
}

model SchoolYear {
  id          String    @id @default(cuid())
  name        String    @unique  // "2024-2025"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  classes     Class[]
  grades      Grade[]
  payments    Payment[]
  attendances Attendance[]

  @@index([isCurrent])
}

model Student {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matricule       String        @unique
  dateOfBirth     DateTime
  gender          Gender
  address         String?
  bloodType       String?
  medicalNotes    String?
  classId         String?
  class           Class?        @relation(fields: [classId], references: [id])
  parentId        String?
  parent          Parent?       @relation(fields: [parentId], references: [id])
  enrollmentDate  DateTime      @default(now())
  status          StudentStatus @default(ACTIVE)

  attendances     Attendance[]
  grades          Grade[]
  payments        Payment[]

  @@index([classId])
  @@index([parentId])
  @@index([status])
  @@index([matricule])
}

model Teacher {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId      String    @unique
  degree          String?
  specialization  String?
  salary          Decimal?  @db.Decimal(10, 2)
  hireDate        DateTime  @default(now())
  contractType    String?   // CDI, CDD, Vacataire

  subjects        TeacherSubject[]
  classes         Class[]    @relation("ClassMainTeacher")
  schedules       Schedule[]

  @@index([employeeId])
}

model Parent {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation  String?
  workplace   String?
  
  children    Student[]
}

model Class {
  id              String      @id @default(cuid())
  name            String      // "1AM-A", "2AS-Math"
  level           Level
  section         String?     // "A", "B", "Math", "Sciences"
  maxStudents     Int         @default(30)
  schoolYearId    String
  schoolYear      SchoolYear  @relation(fields: [schoolYearId], references: [id])
  mainTeacherId   String?
  mainTeacher     Teacher?    @relation("ClassMainTeacher", fields: [mainTeacherId], references: [id])
  roomId          String?
  room            Room?       @relation(fields: [roomId], references: [id])
  createdAt       DateTime    @default(now())

  students        Student[]
  schedules       Schedule[]
  attendances     Attendance[]
  grades          Grade[]

  @@unique([name, schoolYearId])
  @@index([schoolYearId])
  @@index([level])
}

model Subject {
  id            String    @id @default(cuid())
  name          String    // "Mathématiques", "Physique"
  code          String    @unique
  description   String?
  coefficient   Int       @default(1)
  color         String?   // Pour l'affichage dans l'emploi du temps

  teachers      TeacherSubject[]
  schedules     Schedule[]
  grades        Grade[]
  courses       Course[]

  @@index([code])
}

model TeacherSubject {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model Room {
  id          String    @id @default(cuid())
  name        String    @unique  // "Salle 101"
  capacity    Int
  type        RoomType  @default(CLASSROOM)
  building    String?
  floor       Int?
  equipment   String?   // Liste d'équipements

  classes     Class[]
  schedules   Schedule[]
}

model Schedule {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  dayOfWeek   DayOfWeek
  startTime   String    // "08:00"
  endTime     String    // "09:00"
  createdAt   DateTime  @default(now())

  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomId, dayOfWeek])
}

model Attendance {
  id            String            @id @default(cuid())
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String
  class         Class             @relation(fields: [classId], references: [id])
  schoolYearId  String
  schoolYear    SchoolYear        @relation(fields: [schoolYearId], references: [id])
  date          DateTime
  status        AttendanceStatus
  justification String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([studentId, classId, date])
  @@index([date])
  @@index([status])
}

model Grade {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String
  class         Class       @relation(fields: [classId], references: [id])
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id])
  schoolYearId  String
  schoolYear    SchoolYear  @relation(fields: [schoolYearId], references: [id])
  type          GradeType
  value         Decimal     @db.Decimal(5, 2)
  maxValue      Decimal     @default(20) @db.Decimal(5, 2)
  coefficient   Decimal     @default(1) @db.Decimal(3, 2)
  term          Int         // 1, 2, 3 (trimestre)
  description   String?
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([studentId, subjectId, term])
  @@index([classId, subjectId])
}

model Payment {
  id            String        @id @default(cuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYearId  String
  schoolYear    SchoolYear    @relation(fields: [schoolYearId], references: [id])
  type          PaymentType
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime
  paidDate      DateTime?
  paidAmount    Decimal?      @db.Decimal(10, 2)
  method        PaymentMethod?
  status        PaymentStatus @default(PENDING)
  reference     String?       // Numéro de facture
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([studentId, schoolYearId])
  @@index([status])
  @@index([dueDate])
}

model Notification {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  isRead      Boolean           @default(false)
  data        Json?
  createdAt   DateTime          @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  userId      String?
  action      String    // "CREATE", "UPDATE", "DELETE"
  entity      String    // "Student", "Teacher", etc.
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ==================== RBAC PERMISSIONS ====================

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique  // "students.view", "students.create", etc.
  description String?
  module      String    // "students", "teachers", "grades", etc.
  action      String    // "view", "create", "update", "delete"
  createdAt   DateTime  @default(now())

  roles       RolePermission[]
  users       UserPermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)  // Can be used to revoke specific permissions
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
}

// ==================== MESSAGING SYSTEM ====================

model Conversation {
  id          String    @id @default(cuid())
  title       String?
  isGroup     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId     String?      // For direct messages
  receiver       User?        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content        String
  isRead         Boolean      @default(false)
  attachments    Json?        // Array of file URLs
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([receiverId])
}

// ==================== ACADEMIC RESOURCES ====================

model Course {
  id          String    @id @default(cuid())
  title       String
  description String?
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   String
  classId     String?
  level       Level?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  resources   Resource[]
  quizzes     Quiz[]

  @@index([subjectId])
  @@index([teacherId])
}

model Resource {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        ResourceType
  fileUrl     String?
  linkUrl     String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())

  @@index([courseId])
}

enum ResourceType {
  PDF
  VIDEO
  AUDIO
  IMAGE
  LINK
  DOCUMENT
}

// ==================== QUIZZES & EXAMS ====================

model Quiz {
  id           String       @id @default(cuid())
  courseId     String?
  course       Course?      @relation(fields: [courseId], references: [id])
  title        String
  description  String?
  duration     Int?         // Duration in minutes
  maxAttempts  Int          @default(1)
  passingScore Decimal?     @db.Decimal(5, 2)
  isPublished  Boolean      @default(false)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  questions    Question[]
  attempts     QuizAttempt[]

  @@index([courseId])
}

model Question {
  id           String       @id @default(cuid())
  quizId       String
  quiz         Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type         QuestionType
  text         String
  options      Json?        // Array of options for MCQ
  correctAnswer Json        // Can be single value or array for multiple correct
  points       Decimal      @default(1) @db.Decimal(5, 2)
  explanation  String?
  order        Int          @default(0)
  createdAt    DateTime     @default(now())

  answers      Answer[]

  @@index([quizId])
}

enum QuestionType {
  MCQ           // Multiple Choice Question
  TRUE_FALSE    // True/False
  SHORT_ANSWER  // Short text answer
  LONG_ANSWER   // Long text answer (essay)
  FILL_BLANK    // Fill in the blank
  MATCHING      // Matching pairs
  ORDERING      // Order items
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Decimal?  @db.Decimal(5, 2)
  maxScore    Decimal?  @db.Decimal(5, 2)
  isPassed    Boolean?
  attemptNumber Int     @default(1)

  answers     Answer[]

  @@index([quizId])
  @@index([studentId])
}

model Answer {
  id          String      @id @default(cuid())
  attemptId   String
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question    @relation(fields: [questionId], references: [id])
  answer      Json        // Student's answer
  isCorrect   Boolean?
  points      Decimal?    @db.Decimal(5, 2)
  feedback    String?
  createdAt   DateTime    @default(now())

  @@index([attemptId])
  @@index([questionId])
}
