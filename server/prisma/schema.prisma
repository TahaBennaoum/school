// Système de Gestion d'École Privée - Schéma Prisma
// CEM et Lycée

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  DIRECTOR
  TEACHER
  STUDENT
  PARENT
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum Level {
  // CEM (Collège)
  AM1  // 1ère Année Moyenne
  AM2  // 2ème Année Moyenne
  AM3  // 3ème Année Moyenne
  AM4  // 4ème Année Moyenne (BEM)
  // Lycée
  AS1  // 1ère Année Secondaire
  AS2  // 2ème Année Secondaire
  AS3  // 3ème Année Secondaire (BAC)
}

enum RoomType {
  CLASSROOM
  LAB
  LIBRARY
  GYM
  AUDITORIUM
  COMPUTER_LAB
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum GradeType {
  HOMEWORK    // Devoir
  QUIZ        // Interrogation
  EXAM        // Examen
  PROJECT     // Projet
  COMPOSITION // Composition trimestrielle
}

enum PaymentType {
  REGISTRATION  // Frais d'inscription
  TUITION       // Scolarité mensuelle
  TRANSPORT     // Transport
  CANTEEN       // Cantine
  UNIFORM       // Uniforme
  BOOKS         // Livres
  OTHER         // Autre
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum NotificationType {
  ABSENCE
  GRADE
  PAYMENT
  SCHEDULE
  GENERAL
}

// ==================== MODELS ====================

model User {
  id            String    @id @default(cuid())
  supabaseId    String    @unique
  email         String    @unique
  firstName     String
  lastName      String
  role          Role      @default(TEACHER)
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations optionnelles (un seul sera défini selon le rôle)
  student       Student?
  teacher       Teacher?
  parent        Parent?

  notifications Notification[]

  @@index([email])
  @@index([supabaseId])
  @@index([role])
}

model SchoolYear {
  id          String    @id @default(cuid())
  name        String    @unique  // "2024-2025"
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  classes     Class[]
  grades      Grade[]
  payments    Payment[]
  attendances Attendance[]

  @@index([isCurrent])
}

model Student {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matricule       String        @unique
  dateOfBirth     DateTime
  gender          Gender
  address         String?
  bloodType       String?
  medicalNotes    String?
  classId         String?
  class           Class?        @relation(fields: [classId], references: [id])
  parentId        String?
  parent          Parent?       @relation(fields: [parentId], references: [id])
  enrollmentDate  DateTime      @default(now())
  status          StudentStatus @default(ACTIVE)

  attendances     Attendance[]
  grades          Grade[]
  payments        Payment[]

  @@index([classId])
  @@index([parentId])
  @@index([status])
  @@index([matricule])
}

model Teacher {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId      String    @unique
  degree          String?
  specialization  String?
  salary          Decimal?  @db.Decimal(10, 2)
  hireDate        DateTime  @default(now())
  contractType    String?   // CDI, CDD, Vacataire

  subjects        TeacherSubject[]
  classes         Class[]    @relation("ClassMainTeacher")
  schedules       Schedule[]

  @@index([employeeId])
}

model Parent {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation  String?
  workplace   String?
  
  children    Student[]
}

model Class {
  id              String      @id @default(cuid())
  name            String      // "1AM-A", "2AS-Math"
  level           Level
  section         String?     // "A", "B", "Math", "Sciences"
  maxStudents     Int         @default(30)
  schoolYearId    String
  schoolYear      SchoolYear  @relation(fields: [schoolYearId], references: [id])
  mainTeacherId   String?
  mainTeacher     Teacher?    @relation("ClassMainTeacher", fields: [mainTeacherId], references: [id])
  roomId          String?
  room            Room?       @relation(fields: [roomId], references: [id])
  createdAt       DateTime    @default(now())

  students        Student[]
  schedules       Schedule[]
  attendances     Attendance[]
  grades          Grade[]

  @@unique([name, schoolYearId])
  @@index([schoolYearId])
  @@index([level])
}

model Subject {
  id            String    @id @default(cuid())
  name          String    // "Mathématiques", "Physique"
  code          String    @unique
  description   String?
  coefficient   Int       @default(1)
  color         String?   // Pour l'affichage dans l'emploi du temps

  teachers      TeacherSubject[]
  schedules     Schedule[]
  grades        Grade[]

  @@index([code])
}

model TeacherSubject {
  id          String    @id @default(cuid())
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model Room {
  id          String    @id @default(cuid())
  name        String    @unique  // "Salle 101"
  capacity    Int
  type        RoomType  @default(CLASSROOM)
  building    String?
  floor       Int?
  equipment   String?   // Liste d'équipements

  classes     Class[]
  schedules   Schedule[]
}

model Schedule {
  id          String    @id @default(cuid())
  classId     String
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacherId   String
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id])
  dayOfWeek   DayOfWeek
  startTime   String    // "08:00"
  endTime     String    // "09:00"
  createdAt   DateTime  @default(now())

  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([roomId, dayOfWeek])
}

model Attendance {
  id            String            @id @default(cuid())
  studentId     String
  student       Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String
  class         Class             @relation(fields: [classId], references: [id])
  schoolYearId  String
  schoolYear    SchoolYear        @relation(fields: [schoolYearId], references: [id])
  date          DateTime
  status        AttendanceStatus
  justification String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([studentId, classId, date])
  @@index([date])
  @@index([status])
}

model Grade {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String
  class         Class       @relation(fields: [classId], references: [id])
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id])
  schoolYearId  String
  schoolYear    SchoolYear  @relation(fields: [schoolYearId], references: [id])
  type          GradeType
  value         Decimal     @db.Decimal(5, 2)
  maxValue      Decimal     @default(20) @db.Decimal(5, 2)
  coefficient   Decimal     @default(1) @db.Decimal(3, 2)
  term          Int         // 1, 2, 3 (trimestre)
  description   String?
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([studentId, subjectId, term])
  @@index([classId, subjectId])
}

model Payment {
  id            String        @id @default(cuid())
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYearId  String
  schoolYear    SchoolYear    @relation(fields: [schoolYearId], references: [id])
  type          PaymentType
  amount        Decimal       @db.Decimal(10, 2)
  dueDate       DateTime
  paidDate      DateTime?
  paidAmount    Decimal?      @db.Decimal(10, 2)
  method        PaymentMethod?
  status        PaymentStatus @default(PENDING)
  reference     String?       // Numéro de facture
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([studentId, schoolYearId])
  @@index([status])
  @@index([dueDate])
}

model Notification {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  isRead      Boolean           @default(false)
  data        Json?
  createdAt   DateTime          @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model ActivityLog {
  id          String    @id @default(cuid())
  userId      String?
  action      String    // "CREATE", "UPDATE", "DELETE"
  entity      String    // "Student", "Teacher", etc.
  entityId    String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}
